# Copie para .env.local e preencha. Tudo aqui vai pro navegador:
# NUNCA coloque senha, token ou chave nestas variaveis.

# De onde vem o catalogo:
#   dev com o backend local:  http://127.0.0.1:8000/vitrine/
#   site publicado (snapshot gerado por scripts/exportar_vitrine.py): /dados/vitrine.json
#   demonstracao (dados ficticios): /demo/vitrine.json
NEXT_PUBLIC_VITRINE_DADOS=/demo/vitrine.json

# WhatsApp que recebe os pedidos, so digitos com DDI+DDD (ex.: 5597991234567).
# Vazio = botoes do WhatsApp ficam desativados.
NEXT_PUBLIC_WHATSAPP=

# @ do Instagram sem o @ (vazio = nao mostra)
NEXT_PUBLIC_INSTAGRAM=

# Endereco no rodape (vazio = usa o das Configuracoes do Vertex)
NEXT_PUBLIC_ENDERECO=

# Horario de atendimento (vazio = nao mostra)
NEXT_PUBLIC_HORARIO=

# Avisos da barra do topo, separados por |
# Video da loja na secao que expande ao rolar (ex.: /marca/loja.mp4). Vazio = foto de destaque.
NEXT_PUBLIC_VIDEO=

NEXT_PUBLIC_AVISOS=

# Endereco publico do site (SEO/compartilhamento), ex.: https://3lavariedades.com.br
NEXT_PUBLIC_SITE_URL=
