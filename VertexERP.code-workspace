{
    "folders": [
        {
            "name": "backend",
            "path": "backend"
        },
        {
            "name": "frontend",
            "path": "frontend"
        }
    ],
    "settings": {
        "python.terminal.activateEnvironment": true
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Backend: FastAPI (uvicorn)",
                "type": "debugpy",
                "request": "launch",
                "module": "uvicorn",
                "args": [
                    "main:app",
                    "--reload",
                    "--host",
                    "127.0.0.1",
                    "--port",
                    "8000"
                ],
                "cwd": "${workspaceFolder:backend}",
                "python": "${workspaceFolder:backend}/.venv/Scripts/python.exe",
                "console": "integratedTerminal",
                "justMyCode": true
            },
            {
                "name": "Frontend: Vertex ERP (PySide6)",
                "type": "debugpy",
                "request": "launch",
                "program": "${workspaceFolder:frontend}/app.py",
                "cwd": "${workspaceFolder:frontend}",
                "python": "${workspaceFolder:frontend}/.venv/Scripts/python.exe",
                "console": "integratedTerminal",
                "justMyCode": true
            }
        ]
    }
}
